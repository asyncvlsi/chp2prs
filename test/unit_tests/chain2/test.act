namespace testme {
export
template<|pint V>
defproc onebuf(chan?(int) L; chan!(int) R) {
  int x;
  chp {
    *[
      L?x;
      R!(x+V)
    ]
  }
}
}

template<pint N>
defproc nbuf(chan?(int) L; chan!(int) R) {
  { N > 0 : "Need at least one buffer!" };
  (i:N: testme::onebuf<i> b[i..i];)
  ( i : N - 1:
    b[i].R = b[i + 1].L;
  )
  b[0].L = L;
  b[N - 1].R = R;
}


defproc chain2(chan?(int) A; chan!(int<32>) Y) {
  nbuf<8> x(.L = A, .R = Y);
}
