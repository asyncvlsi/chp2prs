import "7decomp.act";

defproc test ()
{
    chan(pair) A,B,C,D;
    decomp_le7 l(A,C,B,D);

    pair x1, x2, x3;
    
    chp {
        A!pair(0) , (C!pair(0);C!pair(1)) , (D?x1;D?x2), (B?x3);

         [ x1.a=0 & x2.a=1 & x3.a=1 -> log ("SUCCESS") 
        [] else -> log ("FAILURE") 
        ]
    
    }
}
